# Copy this file to .env.production on the VM and fill in all values.
# .env.production is gitignored — never commit it with real values.

# Public hostname (no scheme, no trailing slash)
HOSTNAME=app.example.com

# CORS allowed origin (full URL with scheme)
ALLOWED_ORIGIN=https://app.example.com

# Google OAuth 2.0 Client ID (public — safe to set here, not a secret)
GOOGLE_CLIENT_ID=

# Plaid environment: production | sandbox
PLAID_ENV=production

# Plaid products requested during Link
PLAID_PRODUCTS=auth,transactions,investments

# Plaid country codes
PLAID_COUNTRY_CODES=US,CA

# Rust log filter
RUST_LOG=info,sqlx=warn,tower_http=info

# Operator-blind privacy encryption (off | on). When on, users can opt in to
# per-user encryption of transaction descriptions, merchant names, notes, and
# account names: data is sealed to a per-user X25519 public key at Plaid-sync
# time, and the private key is only ever held wrapped under the user's
# passphrase (or an API token's value) — the server operator cannot read those
# fields by querying the DB. Trade-offs: users must set and remember a
# passphrase (no recovery — a lost passphrase means re-syncing from the bank),
# and text search runs app-side for encrypted users. Amounts, dates, tags,
# holdings, and investment transactions remain plaintext so aggregation works.
PRIVACY_ENCRYPTION=off

# Demo mode (off | on). A public, no-login demo instance. When on: Google login
# and bank linking are DISABLED; visitors click "Try the demo" to get an
# ephemeral account pre-populated with a clone of the demo template user's
# data, and demo users are deleted daily. Requires PLAID_ENV=sandbox and a
# seeded template — run `admin demo seed` once. Leave off for real deployments.
DEMO_MODE=off

# Subscription billing / paywall (off | on). When on:
#   - Sign-up opens to everyone (the invite allowlist stops gating logins);
#     the paywall is the gate instead. OWNER_EMAILS always bypass the paywall.
#   - Users without an active Stripe subscription get 402 on all data routes
#     and MCP; they can still log in, see the paywall, check out, and manage
#     billing. One plan: $8/month or $80/year, via Stripe Checkout (Apple Pay /
#     Google Pay included) + Stripe Customer Portal.
#   - Requires the STRIPE_* settings below. Point a Stripe webhook (dashboard or
#     `stripe listen`) at POST /api/billing/webhook with events:
#     checkout.session.completed, customer.subscription.created,
#     customer.subscription.updated, customer.subscription.deleted,
#     invoice.payment_failed.
#   - Enable Stripe Tax in the Stripe dashboard (origin address + registrations)
#     — checkout sessions are created with automatic_tax enabled.
# Leave off to keep the deployment invite-only and unmetered.
BILLING=off

# Stripe secret API key (sk_test_… / sk_live_…). Prefer the _FILE variant with
# a docker secret in production: STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_secret_key
#STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) for the /api/billing/webhook endpoint.
#STRIPE_WEBHOOK_SECRET=
# Recurring price ids for the single product (create in the Stripe dashboard).
#STRIPE_PRICE_MONTHLY=price_...   # $8 / month
#STRIPE_PRICE_ANNUAL=price_...    # $80 / year
# Optional free trial in days applied at checkout (omit for none).
#STRIPE_TRIAL_DAYS=7
