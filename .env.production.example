# Copy this file to .env.production on the VM and fill in all values.
# .env.production is gitignored — never commit it with real values.

# Public hostname (no scheme, no trailing slash)
HOSTNAME=app.example.com

# CORS allowed origin (full URL with scheme)
ALLOWED_ORIGIN=https://app.example.com

# Google OAuth 2.0 Client ID (public — safe to set here, not a secret)
GOOGLE_CLIENT_ID=

# Plaid environment: production | sandbox
PLAID_ENV=production

# Plaid products requested during Link
PLAID_PRODUCTS=auth,transactions,investments

# Plaid country codes
PLAID_COUNTRY_CODES=US,CA

# Rust log filter
RUST_LOG=info,sqlx=warn,tower_http=info

# Operator-blind privacy encryption (off | on). When on, users can opt in to
# per-user encryption of transaction descriptions, merchant names, notes, and
# account names: data is sealed to a per-user X25519 public key at Plaid-sync
# time, and the private key is only ever held wrapped under the user's
# passphrase (or an API token's value) — the server operator cannot read those
# fields by querying the DB. Trade-offs: users must set and remember a
# passphrase (no recovery — a lost passphrase means re-syncing from the bank),
# and text search runs app-side for encrypted users. Amounts, dates, tags,
# holdings, and investment transactions remain plaintext so aggregation works.
PRIVACY_ENCRYPTION=off
